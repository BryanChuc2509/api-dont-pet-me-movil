# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API / API Keys).

PORT=3000
NODE_ENV=development

# URL del proyecto: https://<ref>.supabase.co
SUPABASE_URL=

# Clave SECRETA (sb_secret_... o la "service_role" heredada).
# Solo vive en el servidor: nunca la pongas en la app móvil.
SUPABASE_SECRET_KEY=

# Bucket de Storage donde viven imágenes y videos
SUPABASE_BUCKET=media

# Orígenes permitidos por CORS (coma separada). "*" = cualquiera (solo desarrollo).
CORS_ORIGINS=*

# Segundos de caché HTTP para respuestas GET
CACHE_MAX_AGE=60

# Carpeta de assets de la app que usa el seed para subir los archivos a Storage
MEDIA_SOURCE_DIR=../app-movil/assets
